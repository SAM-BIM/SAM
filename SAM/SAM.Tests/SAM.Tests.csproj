<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <RootNamespace>SAM.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAM.Core\SAM.Core.csproj" />
    <ProjectReference Include="..\SAM.Analytical\SAM.Analytical.csproj" />
    <ProjectReference Include="..\SAM.Architectural\SAM.Architectural.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same TM59 TextMap resource SAM.Analytical.Query.DefaultInternalConditionTextMap_TM59 loads,
         copied locally so TM59AssessmentCalculatorTests / TMOverheatingCalculatorTests / VentilationStrategyTests
         / PartOResultAssociationTests / PartOIterationSliceTests don't depend on a %APPDATA%\SAM install or on
         Assembly.CodeBase-based path discovery resolving correctly under the test host - see
         TM59TextMapModuleInitializer, which seeds ActiveSetting.Setting from this file at process start. -->
    <None Include="..\..\files\resources\Analytical\SAM_InternalConditionTextMap_TM59.JSON">
      <Link>Resources\SAM_InternalConditionTextMap_TM59.JSON</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
